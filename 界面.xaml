<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="星脉 · 资源管家" Width="1200" Height="810" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#090E1B" Foreground="#E8EFFB" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#94A5C0"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#1C3049"/><Setter Property="Foreground" Value="#E8EFFB"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111C30"/><Setter Property="BorderBrush" Value="#23334E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E8EFFB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#111C30"/><Setter Property="AlternatingRowBackground" Value="#142038"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="53"/><Setter Property="FontSize" Value="13"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#0F192B"/><Setter Property="Foreground" Value="#94A5C0"/><Setter Property="Padding" Value="12,12"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#254363"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="26,20,26,14"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="178"/><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock FontSize="25" FontWeight="Bold"><Run Foreground="#46E1EC">◈ </Run><Run>星脉</Run><Run Foreground="#94A5C0" FontSize="16">  /  资源管家</Run></TextBlock><TextBlock Text="看清资源去向，把流畅交还给电脑。" Foreground="{StaticResource Muted}" Margin="2,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#15343C" CornerRadius="14" Padding="12,7"><TextBlock x:Name="Live" Text="●  实时监测 · 每 2 秒" Foreground="#54E6CD"/></Border></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="238"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions><TextBlock Text="CPU  /  处理器" Foreground="{StaticResource Muted}"/><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CpuValue" Text="—" FontSize="39" FontWeight="Bold" Foreground="#46E1EC"/><TextBlock x:Name="CpuInfo" Margin="14,19,0,0" Foreground="{StaticResource Muted}"/></StackPanel><Grid Grid.Row="2" x:Name="CpuPlot" ClipToBounds="True"><Polyline x:Name="CpuLine" Stroke="#46E1EC" StrokeThickness="2"/></Grid></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions><TextBlock Text="RAM  /  物理内存" Foreground="{StaticResource Muted}"/><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="MemValue" Text="—" FontSize="39" FontWeight="Bold" Foreground="#B69CFF"/><TextBlock x:Name="MemInfo" Margin="14,12,0,0" Foreground="{StaticResource Muted}"/></StackPanel><Grid Grid.Row="2" x:Name="MemPlot" ClipToBounds="True"><Polyline x:Name="MemLine" Stroke="#B69CFF" StrokeThickness="2"/></Grid></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前状态" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Health" Text="正在读取…" FontSize="23" FontWeight="Bold" Margin="0,12,0,8"/><TextBlock x:Name="Advice" Text="正在采集本机实时数据" Foreground="{StaticResource Muted}" LineHeight="21"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Border Background="#142038" CornerRadius="6" Margin="0,0,12,0" Padding="10,3"><DockPanel><TextBlock Text="搜索软件  " VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBox x:Name="Search" BorderThickness="0" Background="Transparent" Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" ToolTip="输入软件名或进程名"/></DockPanel></Border><Button Grid.Column="1" x:Name="Sort" Content="排序：内存 ↓" Margin="0,0,10,0" Padding="10,6"/><Button Grid.Column="2" x:Name="Pause" Content="暂停" Margin="0" Padding="10,6"/></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions><DataGrid x:Name="Apps"><DataGrid.Columns>
    <DataGridTemplateColumn Header="软件 / 进程组" Width="*" MinWidth="210" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="25" Height="25" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#94A5C0" TextWrapping="NoWrap"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80" CanUserSort="False"/>
    <DataGridTemplateColumn Header="内存" Width="125" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding MemoryText}"/><ProgressBar Value="{Binding MemoryPercent}" Maximum="100" Height="3" Margin="0,6,0,0" Background="#26334F" Foreground="#B69CFF" BorderThickness="0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="进程" Binding="{Binding Count}" Width="58" CanUserSort="False"/>
   </DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" x:Name="ListInfo" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,8,0,0" Text="正在读取…"/></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="程序详情" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DetailName" Text="选择一个软件" FontSize="22" FontWeight="Bold" Margin="0,12,0,8"/><TextBlock x:Name="DetailStats" Text="从左侧列表选择，查看占用与窗口。" Foreground="#46E1EC"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,10"><TextBlock x:Name="Details" Foreground="{StaticResource Muted}" LineHeight="21"/></ScrollViewer><StackPanel Grid.Row="2"><TextBlock x:Name="Protection" Foreground="#FFC780" FontSize="11" Margin="0,0,0,7"/><Button x:Name="CloseApp" Content="正常退出" Background="#19616B" IsEnabled="False"/><Button x:Name="KillApp" Content="强制结束…" Background="#613345" IsEnabled="False"/><TextBlock Text="退出前请保存工作。内存含共享页面，关闭后释放量以实际为准。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Grid></Border>
  </Grid>
  <TextBlock Grid.Row="4" x:Name="Status" Text="本地运行 · 无需联网 · 关键系统进程受保护" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Bottom"/>
 </Grid>
</Window>
